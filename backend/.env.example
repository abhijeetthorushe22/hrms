# Copy to .env and fill in your values

# Database (MongoDB Atlas connection string)
DATABASE_URL=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?appName=Cluster0

# Security - generate a long random string for production
SECRET_KEY=change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Google Gemini API (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your-gemini-api-key
GEMINI_MODEL_NAME=gemini-2.0-flash

# AI Features
INIT_AI_ON_STARTUP=false
ENABLE_SPACY_PROCESSING=false
ENABLE_GEMINI_FALLBACK=true
ENABLE_ML_CLASSIFIER=false
ENABLE_ENTITY_EXTRACTION=true
ENABLE_ADVANCED_PDF=true

# Frontend URL for CORS (set after deploying frontend)
FRONTEND_URL=https://your-app.vercel.app

# File Storage
UPLOAD_DIR=./uploads
CHROMA_PERSIST_DIRECTORY=./chroma_db

# Server
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
ENABLE_DOCS=true
